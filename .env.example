# RobotEvents API token — get one at https://www.robotevents.com/api/v2 (Account → API)
# Copy this file to `.env` (git-ignored) and fill in your token.

EXPO_PUBLIC_VEX_API_TOKEN=your-bearer-token

# Optional: pin a RobotEvents season id. If omitted, the app resolves the
# current VRC season automatically.
# EXPO_PUBLIC_VEX_SEASON_ID=190
