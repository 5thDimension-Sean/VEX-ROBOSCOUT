# Public VEX Events API token (Bearer JWT) — from the VEX Events platform
# at https://events.vex.com/api/v2 (VEX's own API after the 2026 VEX/RECF split).
# Copy this file to `.env` (git-ignored) and fill in your token.

EXPO_PUBLIC_VEX_API_TOKEN=your-bearer-jwt

# Optional: program id. Defaults to 1 (V5RC, formerly VRC). Change if your data
# comes back for the wrong program after the rebrand (VIQRC, VURC, VEX AI, …).
# EXPO_PUBLIC_VEX_PROGRAM_ID=1

# Optional: pin a season id. If omitted, the current season is resolved.
# EXPO_PUBLIC_VEX_SEASON_ID=
