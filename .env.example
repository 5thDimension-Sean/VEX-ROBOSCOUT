# Public VEX Events API (https://events.vex.com/api/v2) — VEX's own platform
# after the 2026 VEX/RECF split. Copy this file to `.env` (git-ignored).

# --- DIRECT mode (native app / local dev) ---
# Bearer JWT from the VEX Events platform. Used when EXPO_PUBLIC_VEX_PROXY_URL
# is not set.
EXPO_PUBLIC_VEX_API_TOKEN=your-bearer-jwt

# --- PROXY mode (web / public deploy) ---
# When set, the app calls this Cloudflare Worker (see proxy/) instead of
# events.vex.com directly, so the token never ships in the public bundle.
# EXPO_PUBLIC_VEX_PROXY_URL=https://vex-robotscout-proxy.<you>.workers.dev

# Optional: program id. Defaults to 1 (V5RC, formerly VRC).
# EXPO_PUBLIC_VEX_PROGRAM_ID=1

# Optional: pin a season id. If omitted, the current season is resolved.
# EXPO_PUBLIC_VEX_SEASON_ID=
